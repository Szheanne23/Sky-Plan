# ==============================================================================
# SkyPlan — Environment Configuration Template
# NOTE: Copy this file to .env in respective directories and fill in real values.
# NEVER commit real credentials or .env files to source control.
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/skyplan_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=skyplan_db

# Security & Authentication (Required for Phase 1+)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# External APIs (Required for Phase 4+)
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Frontend Application Origin (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Frontend Environment Variables (Prefix with VITE_)
VITE_API_URL=http://localhost:5000/api
