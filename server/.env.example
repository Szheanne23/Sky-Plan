# SkyPlan Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/skyplan_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=skyplan_db

# Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# External APIs
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# CORS Origin
CLIENT_ORIGIN=http://localhost:5173
